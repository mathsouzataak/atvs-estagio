<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pedido_Ativo</fullName>
    <active>true</active>
    <description>O pedido não</description>
    <errorConditionFormula>AND(NOT(ISNEW()),  ISPICKVAL(Order.Status, &apos;Activated&apos;))</errorConditionFormula>
    <errorMessage>O pedido está ativo e não pode ter seus itens alterados.</errorMessage>
</ValidationRule>
