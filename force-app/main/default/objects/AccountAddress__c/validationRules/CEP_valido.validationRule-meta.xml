<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CEP_valido</fullName>
    <active>true</active>
    <description>O CEP deve ter formato válido</description>
    <errorConditionFormula>NOT(REGEX( CEP__c , &quot;[0-9]{2}(\\.|\\s)?[0-9]{3}(\\.|\\s)?[0-9]{2}\\n&quot;))</errorConditionFormula>
    <errorDisplayField>CEP__c</errorDisplayField>
    <errorMessage>CEP em formato inválido</errorMessage>
</ValidationRule>
