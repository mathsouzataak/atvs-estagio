<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CNPJ_valido</fullName>
    <active>true</active>
    <description>O CNPJ deve ter formato válido.</description>
    <errorConditionFormula>NOT(REGEX( CNPJ__c , &quot;^[0-9]{2}[\\.]?[0-9]{3}[\\.]?[0-9]{3}[\\/]?[0-9]{4}[-]?[0-9]{2}$&quot;))</errorConditionFormula>
    <errorDisplayField>CNPJ__c</errorDisplayField>
    <errorMessage>CNPJ inválido</errorMessage>
</ValidationRule>
