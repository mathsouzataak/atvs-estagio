<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_Family_Must_Be_Specified</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
  RecordType.Name = &apos;ProductFamily&apos;, 
  ISBLANK( ProductFamily__c )
)</errorConditionFormula>
    <errorDisplayField>ProductFamily__c</errorDisplayField>
    <errorMessage>Meta de família de produto deve ter a família especificada.</errorMessage>
</ValidationRule>
